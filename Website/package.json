{
  "name": "lucky-draw-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:phase1": "node tools/verification/verify-phase1-auth-db.mjs",
    "verify:auth": "node tools/verification/verify-auth-foundation.mjs",
    "verify:platform": "node tools/verification/verify-platform-foundation.mjs",
    "verify:ynot": "npm run verify:phase1 && npm run verify:auth && npm run verify:platform && npm run verify:phase-readiness && npm run verify:hardening && npm run verify:production-test && node tools/verification/verify-lucky-draw-plan.mjs",
    "check": "npm run lint && npm run typecheck && npm run verify:ynot && npm run build",
    "verify:phase-readiness": "node tools/verification/verify-phase-readiness.mjs",
    "test:uploads": "node --test scripts/test-magic-bytes.mjs",
    "verify:hardening": "npm run test:uploads && node tools/verification/verify-hardening.mjs",
    "verify:production-test": "node tools/verification/verify-production-test-readiness.mjs",
    "verify:production-db": "node tools/verification/check-production-supabase-readiness.mjs"
  },
  "dependencies": {
    "@line/liff": "^2.28.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
RATE_LIMIT_BACKEND=supabase
LINE_SESSION_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_LINE_LIFF_ID=2009942829-gDxsXZJR
LINE_LOGIN_CHANNEL_ID=2009942829
LINE_LOGIN_CHANNEL_SECRET=your-server-only-line-channel-secret
# Show the "Continue with LINE" button on /login, /signup, and profile pages.
# Default off until LINE Developers callback is registered. Set to "true" to enable.
NEXT_PUBLIC_ENABLE_LINE_LOGIN=false
SLIP2GO_API_URL=https://connect.slip2go.com
SLIP2GO_SECRET_KEY=your-server-only-slip2go-secret
SLIP2GO_PROMPTPAY_PHONE_ACCOUNT_TYPE=02001
SLIP2GO_PROMPTPAY_NATIONAL_ID_ACCOUNT_TYPE=02002
SLIP2GO_PROMPTPAY_EWALLET_ACCOUNT_TYPE=02003
SLIP2GO_BANK_ACCOUNT_TYPE=
SLIP2GO_BANK_ACCOUNT_TYPES_JSON=
SLIP2GO_TIMEOUT_MS=12000

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
RATE_LIMIT_BACKEND=supabase
SIGNUP_OTP_DELIVERY=resend
SIGNUP_EMAIL_FROM="YNOTT <no-reply@ynotopen.com>"
RESEND_API_KEY=your-server-only-resend-api-key
LINE_SESSION_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_LINE_LIFF_ID=2009971080-8exdgUaw
LINE_LOGIN_CHANNEL_ID=2009971080
LINE_LOGIN_CHANNEL_SECRET=your-server-only-line-channel-secret
# Show the "Continue with LINE" button on /login, /signup, and profile pages.
# Default off until LINE Developers callback is registered. Set to "true" to enable.
NEXT_PUBLIC_ENABLE_LINE_LOGIN=false
SLIP2GO_API_URL=https://connect.slip2go.com
SLIP2GO_SECRET_KEY=your-server-only-slip2go-secret
SLIP2GO_PROMPTPAY_PHONE_ACCOUNT_TYPE=02001
SLIP2GO_PROMPTPAY_NATIONAL_ID_ACCOUNT_TYPE=02002
SLIP2GO_PROMPTPAY_EWALLET_ACCOUNT_TYPE=02003
SLIP2GO_BANK_ACCOUNT_TYPE=
SLIP2GO_BANK_ACCOUNT_TYPES_JSON=
SLIP2GO_TIMEOUT_MS=12000

# Sensitive admin event alerts. At least one of these should be set in
# production so owner-role grants, admin role mutations, profile session
# revocations, and large top-up approvals get pushed somewhere a human reads.
# Both can be set; the app delivers to both channels in parallel.
YNOT_SECURITY_ALERT_EMAIL=
YNOT_SECURITY_ALERT_WEBHOOK=

# Local-only opt-in for the preview/mock auth shortcuts under /api/dev/* and
# the gacha preview path. Production MUST leave this unset — the runtime
# requires BOTH NODE_ENV != production AND YNOT_ENABLE_DEV_AUTH=true.
YNOT_ENABLE_DEV_AUTH=false

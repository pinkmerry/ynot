{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "bulk-open-worker.ts",
  "name": "ynott-website",
  "workers_dev": true,
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "keep_names": false,
  "routes": [
    {
      "pattern": "ynotopen.com/*",
      "zone_name": "ynotopen.com"
    },
    {
      "pattern": "www.ynotopen.com/*",
      "zone_name": "ynotopen.com"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      {
        "binding": "BULK_OPEN_QUEUE",
        "queue": "ynott-bulk-open"
      }
    ],
    "consumers": [
      {
        "queue": "ynott-bulk-open",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "RATE_LIMIT_BACKEND": "supabase",
    "NODE_ENV": "production",
    "NEXTJS_ENV": "production",
    "LINE_LOGIN_CHANNEL_ID": "2009971080",
    "NEXT_PUBLIC_ENABLE_LINE_LOGIN": "true",
    "NEXT_PUBLIC_LINE_LIFF_ID": "2009971080-8exdgUaw",
    "NEXT_PUBLIC_SITE_URL": "https://www.ynotopen.com",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN6am9hcmtpamVhc3BhemJyY2hjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwMjMwMzIsImV4cCI6MjA5MzU5OTAzMn0.yElDtqBA8NPWW8kMRqw3jltuFqfPDJpr1Fek8AjTwFM",
    "NEXT_PUBLIC_SUPABASE_URL": "https://szjoarkijeaspazbrchc.supabase.co",
    "SLIP2GO_API_URL": "https://connect.slip2go.com",
    "SIGNUP_OTP_DELIVERY": "resend",
    "SIGNUP_EMAIL_FROM": "YNOTT <no-reply@ynotopen.com>"
  }
}
